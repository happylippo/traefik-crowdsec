TZ=Europe/Berlin
ABSOLUTE_PATH=${PWD}

# Local hostnames work on the same machine; Traefik serves its default
# self-signed certificate until a public ACME resolver is configured.
TRAEFIK_HOST=traefik.localhost
BASIC_AUTH_USER=admin
TRAEFIK_TAG=v3.7
CROWDSEC_TAG=latest
SOCKET_PROXY_TAG=latest

SERVICES_TRAEFIK_LABELS_TRAEFIK_CERTRESOLVER=cloudflare_resolver
TRAEFIK_CERT_EMAIL=admin@example.com
TRAEFIK_CERT_DOMAIN=example.de
TRAEFIK_CERT_WILDCARD=*.example.de

# Generated automatically by ./scripts/setup.sh. Keep these values private.
BOUNCER_KEY_TRAEFIK=__GENERATE__

# CrowdSec CAPTCHA challenge. Leave CAPTCHA_PROVIDER empty to disable challenges.
# Supported providers: hcaptcha, recaptcha, turnstile.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

PROXY_NETWORK_NAME=proxy
PROXY_NETWORK_SUBNET=172.31.128.0/24
PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:a::/64

CROWDSEC_NETWORK_NAME=crowdsec
CROWDSEC_NETWORK_SUBNET=172.31.64.0/24
CROWDSEC_NETWORK_IPV6_SUBNET=fd00:1:be:b::/64

SOCKET_PROXY_NETWORK_NAME=socket_proxy
SOCKET_PROXY_NETWORK_SUBNET=172.31.192.0/24
SOCKET_PROXY_NETWORK_IPV6_SUBNET=fd00:1:be:c::/64




# Fixed container addresses. Keep each address inside its network subnet
# and unique among the containers connected to that network.
SOCKET_PROXY_IPV4=172.31.192.10
SOCKET_PROXY_IPV6=fd00:1:be:c::10

CROWDSEC_IPV4=172.31.64.10
CROWDSEC_IPV6=fd00:1:be:b::10
CROWDSEC_SOCKET_PROXY_IPV4=172.31.192.20
CROWDSEC_SOCKET_PROXY_IPV6=fd00:1:be:c::20

TRAEFIK_CROWDSEC_IPV4=172.31.64.20
TRAEFIK_CROWDSEC_IPV6=fd00:1:be:b::20
TRAEFIK_PROXY_IPV4=172.31.128.10
TRAEFIK_PROXY_IPV6=fd00:1:be:a::10
TRAEFIK_SOCKET_PROXY_IPV4=172.31.192.30
TRAEFIK_SOCKET_PROXY_IPV6=fd00:1:be:c::30



